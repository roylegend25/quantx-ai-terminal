APP_ENV=production
TRADING_MODE=paper
DATABASE_URL=postgresql://<db_user>:<db_password>@postgres:5432/<db_name>
REDIS_URL=redis://redis:6379/0

# Symbols the scheduler evaluates and paper-trades every cycle (comma-separated)
ENABLED_SYMBOLS=BTCUSDT,ETHUSDT

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-secret

ADMIN_USERNAME=admin

# Generate with: python3 -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=change-me-to-a-bcrypt-hash

# Hard safety gate for backend/app/exchanges - must stay true. No adapter
# implements order placement, so there is no corresponding "live" flag.
EXCHANGE_READ_ONLY=true

# ML lifecycle platform (app/mlops/) - see backend/app/core/config.py for defaults
# AUTO_RETRAIN=true
# MLOPS_RETRAIN_SCHEDULE=daily
# MLOPS_SCHEDULER_INTERVAL_SECONDS=3600
# MAX_MODEL_HISTORY=20
# MODEL_RETENTION_DAYS=90
# CHAMPION_MIN_ACCURACY=0.55
# CHAMPION_MIN_PROFIT_FACTOR=1.0
# CHAMPION_MIN_SHARPE=0.0
# CHAMPION_MAX_DRAWDOWN_PCT=25.0
# CHAMPION_MIN_STABILITY=0.7
# CHAMPION_MAX_LATENCY_MS=500.0
# MAX_ALLOWED_DRIFT=0.25

# Exchange API credentials are all optional - only exchanges with
# credentials set are reported as configured by GET /api/exchange/status.
# Every key below must be created with READ-ONLY permission - no trade,
# transfer or withdrawal scope. Keys detected with withdrawal permission
# are flagged unsafe by GET /api/exchange/risk-check.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# COINBASE_API_KEY_NAME=
# COINBASE_API_PRIVATE_KEY=
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_API_PASSPHRASE=
PUBLIC_APP_URL=https://www.quantxterminal.com
CORS_ALLOWED_ORIGINS=https://www.quantxterminal.com,http://localhost:5173,http://127.0.0.1:5173

# Active Drive decision-engine rollout
ACTIVE_DRIVE_V2_ENABLED=true
ACTIVE_DRIVE_V1_AVAILABLE=true
DEFAULT_DECISION_ENGINE=active_drive_v2
ACTIVE_DRIVE_V1_SHADOW_MODE=false
ACTIVE_DRIVE_V2_SHADOW_ONLY=false
ACTIVE_DRIVE_AUTOMATIC_V1_FALLBACK=false
DEPLOYMENT_MAINTENANCE_MODE=true
DEPLOYMENT_MAINTENANCE_FILE=/app/data/deployment-maintenance
SCHEDULER_STARTUP_GRACE_SECONDS=15
EXECUTION_LEASE_KEY=quantx:production:execution-lease
EXECUTION_LEASE_TTL_SECONDS=30
APP_GIT_SHA=unknown
APP_IMAGE_TAG=unknown
ACTIVE_DRIVE_MIN_TOTAL_EVIDENCE=8.0
ACTIVE_DRIVE_MIN_POINT_MARGIN=4.0
ACTIVE_DRIVE_MIN_CONFIDENCE=0.60
ACTIVE_DRIVE_MIN_RESOLVED_SAMPLES=20
ACTIVE_DRIVE_FAMILY_CAP=12.0
