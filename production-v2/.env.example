# ============================================================================
# QuantX Production V2 — environment configuration
# Copy to `.env`, fill in the values marked CHANGE-ME, then run deploy.sh.
# Every variable in the first section is read by backend/app/core/config.py
# (Settings). The second section is read only by deploy.sh / systemd, not by
# the Python app. Nothing outside this file needs manual editing.
# ============================================================================

# ---- Identity / environment ----
APP_ENV=production
APP_GIT_SHA=unknown          # deploy.sh overwrites this with the deployed commit SHA
APP_IMAGE_TAG=unknown        # deploy.sh overwrites this with the built image tag
TRADING_MODE=paper           # paper | live — leave "paper" until Binance live trading is deliberately enabled

# ---- Database / cache ----
# SQLite, not Postgres: verified in AUDIT.md that no code path in this repo
# ever opens a Postgres connection — PAPER_DATABASE_URL (SQLite, WAL mode) is
# the only database the app actually uses. Path is inside the container;
# docker-compose.yml bind-mounts ./data to persist it on the host.
PAPER_DATABASE_URL=sqlite:////app/data/paper.db
REDIS_URL=redis://redis:6379/0

# ---- Symbols / scheduler ----
ENABLED_SYMBOLS=BTCUSDT,ETHUSDT
DATA_SCHEDULER_ENABLED=true
DATA_REFRESH_INTERVAL_SECONDS=900
SCHEDULER_STARTUP_GRACE_SECONDS=15

# ---- Auth (CHANGE-ME) ----
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME-random-secret
ADMIN_USERNAME=admin
# Generate with: python3 -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=CHANGE-ME-bcrypt-hash
# Fernet key for encrypting Binance Real API credentials at rest.
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=CHANGE-ME-fernet-key

# ---- Public URL / CORS ----
PUBLIC_APP_URL=https://v2.quantxterminal.com
CORS_ALLOWED_ORIGINS=https://v2.quantxterminal.com

# ---- Active Drive V2 (sole decision engine) ----
ACTIVE_DRIVE_V2_ENABLED=true
DEFAULT_DECISION_ENGINE=active_drive_v2
ACTIVE_DRIVE_V2_SHADOW_ONLY=false
ACTIVE_DRIVE_MIN_TOTAL_EVIDENCE=8.0
ACTIVE_DRIVE_MIN_POINT_MARGIN=4.0
ACTIVE_DRIVE_MIN_CONFIDENCE=0.60
ACTIVE_DRIVE_MIN_RESOLVED_SAMPLES=20
ACTIVE_DRIVE_FAMILY_CAP=12.0

# ---- Deployment / execution safety ----
DEPLOYMENT_MAINTENANCE_MODE=true          # deploy.sh flips this off after health checks pass
DEPLOYMENT_MAINTENANCE_FILE=/app/data/deployment-maintenance
EXECUTION_LEASE_KEY=quantx:production-v2:execution-lease
EXECUTION_LEASE_TTL_SECONDS=30

# ---- Exchange safety gates ----
EXCHANGE_READ_ONLY=true                   # hard gate for the read-only exchange adapters (bybit/coinbase/okx) — must stay true, see AUDIT.md
BINANCE_FUTURES_TESTNET=true              # false only once live trading is deliberately provisioned
BINANCE_LIVE_ENABLED=false                # master server-side lock for real order placement

# Binance credentials — read-only monitoring/testnet pair. Leave blank until configured.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# Binance credentials — separate, write-capable LIVE pair. Leave unset until
# deliberately provisioning live trading (see docs/OPERATIONS.md "Going live").
# BINANCE_LIVE_API_KEY=
# BINANCE_LIVE_API_SECRET=

BINANCE_DEFAULT_LEVERAGE=1.0
BINANCE_MAX_LEVERAGE=3.0
BINANCE_MAX_NOTIONAL_PER_TRADE=25.0
BINANCE_MAX_DAILY_LOSS_USDT=20.0
BINANCE_ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT
BINANCE_REQUIRE_TP_SL=true
BINANCE_BLOCK_NEW_TRADES_IF_UNPROTECTED=true
BINANCE_PROTECTION_WATCHDOG_ENABLED=true

# ---- Risk ----
CONFIDENCE_THRESHOLD=70.0
MAX_RISK_PER_TRADE_PCT=0.5
DAILY_LOSS_LIMIT_PCT=2.0
MAX_OPEN_POSITIONS=1

# ---- RESEARCH stack (Day-0 hardening, see ARCHITECTURE.md) ----
# Disables the one background job that has no existing off-switch. Requires
# the ~10-line additive change described in ARCHITECTURE.md; if that change
# hasn't been made yet, this variable is harmless but ignored (defaults to
# the code's current always-on behavior).
ENABLE_MLOPS_SCHEDULER=false
AUTO_RETRAIN=false

# ---- Optional third-party intelligence feeds (OPTIONAL per AUDIT.md, safe to leave blank) ----
# COINGLASS_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=

# ============================================================================
# Deployment / ops-only settings — read by deploy.sh and the systemd units in
# this folder, NOT by backend/app/core/config.py. Safe defaults provided.
# ============================================================================
GHCR_REPO=git@github.com:roylegend25/quantx-ai-terminal.git
DEPLOY_BRANCH=production-v2
BACKEND_IMAGE_PREFIX=quantx-backend-v2
BACKUP_RETENTION_DAYS=14
BACKUP_DIR=/opt/quantx/backups
DATA_DIR=/opt/quantx/data
DOMAIN=v2.quantxterminal.com
LETSENCRYPT_EMAIL=roylegend25@gmail.com
